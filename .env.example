# =========================================================
# EvidenceAI - Environment Configuration Template
# =========================================================

# Flask Secret Key (used for session encryption)
FLASK_SECRET_KEY=EvidenceAI_College_Project_Secret_Key_2026

# Server Port (Render sets this automatically)
PORT=5000

# ---------------------------------------------------------
# DATABASE CONFIGURATION
# ---------------------------------------------------------
# Option 1: Automatic SQLite (Zero configuration needed)
# Default on Render if no MySQL is provided.
# USE_SQLITE=1

# Option 2: Cloud MySQL / Remote MySQL (e.g. TiDB Cloud / Aiven / Clever Cloud)
# MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# MYSQL_USER=your_username
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=evidence_ai
# MYSQL_PORT=4000

# Option 3: Standard MySQL connection URL
# DATABASE_URL=mysql://username:password@hostname:3306/evidence_ai

# Option 4: Local XAMPP/WAMP MySQL (Localhost)
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=evidence_ai
# MYSQL_PORT=3306
