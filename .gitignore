# =========================================================
# EvidenceAI - .gitignore
# =========================================================

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE and Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Environment Variables and Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Uploaded Evidence - Sensitive Files
/uploads/
/uploads/*
!/uploads/.gitkeep

# Generated Reports
/reports/
/reports/*
!/reports/.gitkeep

# Runtime Logs
/logs/
/logs/*
!/logs/.gitkeep
*.log

# AI Model Files
*.pt
*.pth
*.onnx
*.engine
*.weights

# Sample or Test Evidence
EvidenceAI_Sample_Evidence.pdf
EvidenceAI_Faulty_Statement_Test.pdf
EvidenceAI_Police_Theft_Evidence_Test.pdf

# Local Database Backups and Dumps
*.sql.bak
*.dump
*.sqlite
*.sqlite3

# Temporary and Scratch Files
scratch/
*.tmp
*.bak
*.swp
*.swo

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Local Installers and Downloads
GitHubDesktopSetup-x64.exe

# Local GitHub Folder
/GitHub/

# Build and Distribution Files
build/
dist/
*.egg-info/

# Test and Coverage Output
.coverage
htmlcov/
