# =========================================================
# EvidenceAI - .gitignore
# =========================================================

# Python Virtual Environments
venv/
env/
ENV/
.venv/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# IDE / Editor
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# User Uploaded Evidence Files (Keep directory structure)
uploads/*
!uploads/.gitkeep

# Generated PDF Reports (Keep directory structure)
reports/*
!reports/.gitkeep

# Runtime Logs
logs/*
!logs/.gitkeep
*.log

# Sensitive Files / Local Configurations
.env
*.env.local

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary / Scratch Files
scratch/
*.tmp
*.bak

# EvidenceAI local test files
EvidenceAI_Sample_Evidence.pdf
GitHub/
GitHubDesktopSetup-x64.exe

# AI model files
*.pt

# Other local configuration files
.env.*
!.env.example